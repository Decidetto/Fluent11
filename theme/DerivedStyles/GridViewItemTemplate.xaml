<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:pcon="clr-namespace:Playnite.Converters;assembly=Playnite"
                    mc:Ignorable="d">

    <Style x:Key="GridCoverPlayButton" TargetType="{x:Type Button}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Foreground" Value="{DynamicResource TextOnImageBrush}" />
        <Setter Property="Background" Value="{DynamicResource CoverPlayBackplateBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource FluentIconFont}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Circle" Width="22" Height="22" CornerRadius="11" Background="{TemplateBinding Background}">
                        <TextBlock Text="{TemplateBinding Content}" FontSize="10" Margin="1,0,0,0"
                                   Foreground="{TemplateBinding Foreground}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource TextOnImageBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextOnLightBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Opacity" Value="0.85" TargetName="Circle" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GridViewItemTemplate" TargetType="{x:Type GameListItem}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GameListItem}">
                    <Border BorderThickness="{Settings GridItemMargin}" BorderBrush="Transparent" Background="Transparent"
                            CornerRadius="{DynamicResource CardCornerRadius}">
                        <StackPanel Name="PART_PanelHost"
                                    d:DataContext="{x:Static DesignMainViewModel.DesignSelectedGameIntance}">

                            <!-- The helper clips CoverHost to rounded corners (TileClip.cs), so the cover can be
                                 a plain Image like the default theme. An ImageBrush on a rounded Border is
                                 much more expensive to realise when new rows scroll into view. -->
                            <!-- CoverHost is clipped to its rounded rect (TileClip.cs), so anything drawn outside
                                 the tile (shadow, selection bar) has to live beside it, not inside it.
                                 The shadow is one bitmap the helper renders per tile size from TileShadowEffect and
                                 shares between all tiles (TileClip.cs); it is the tile plus 16px on every side. -->
                            <Grid>
                            <Image x:Name="TileShadow" Source="{DynamicResource Fluent11TileShadow}" Stretch="None"
                                   Margin="-20" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   IsHitTestVisible="False" />
                            <Grid x:Name="CoverHost" Width="{Settings GridItemWidth}"
                                  Height="{Settings GridItemHeight}">
                                <Border x:Name="CoverPlaceholder" Background="{DynamicResource GridItemBackgroundBrush}"
                                        CornerRadius="{DynamicResource CardCornerRadius}" />
                                <Image Name="PART_ImageCover"
                                       RenderOptions.BitmapScalingMode="Fant" StretchDirection="Both"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Stretch="{Settings CoverArtStretch}" RenderTransformOrigin="0.5,0.5">
                                    <Image.RenderTransform>
                                        <ScaleTransform />
                                    </Image.RenderTransform>
                                </Image>
                                <Image x:Name="PosterCover" Source="{Binding Tag.Image, ElementName=CoverHost}"
                                       RenderOptions.BitmapScalingMode="Fant" StretchDirection="Both"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Stretch="{Binding Stretch, ElementName=PART_ImageCover}" RenderTransformOrigin="0.5,0.5"
                                       RenderTransform="{Binding RenderTransform, ElementName=PART_ImageCover}" />
                                <Border Background="{DynamicResource CoverNameOverlayBrush}" x:Name="TextGameName"
                                        CornerRadius="{DynamicResource CardCornerRadius}" Visibility="Collapsed">
                                    <TextBlock Text="{Binding DisplayName}"
                                               TextWrapping="Wrap" Margin="8"
                                               Style="{StaticResource BaseTextBlockStyle}"
                                               Foreground="{DynamicResource TextOnImageBrush}"
                                               TextTrimming="CharacterEllipsis" TextAlignment="Center"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Border Background="{DynamicResource CoverHoverOverlayBrush}" x:Name="BorderUninstalled"
                                        CornerRadius="{DynamicResource CardCornerRadius}" Visibility="Collapsed" />
                                <Border x:Name="GameControls" Background="Transparent" Opacity="0"
                                        CornerRadius="{DynamicResource CardCornerRadius}" Visibility="Collapsed">
                                    <Viewbox>
                                        <Button Name="PART_ButtonPlay" Margin="24,0" Content="&#xF5B0;">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource GridCoverPlayButton}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{PluginSettings Plugin=Fluent11Helper, Path=ShowGridPlayButton, FallbackValue=True}" Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </Viewbox>
                                </Border>
                            </Grid>
                            <!-- Stroke lives outside CoverHost so the helper's half-pixel-inset clip doesn't
                                 shave off its outer half. -->
                            <Border CornerRadius="{DynamicResource CardCornerRadius}" BorderThickness="1"
                                    Width="{Binding ActualWidth, ElementName=CoverHost}"
                                    Height="{Binding ActualHeight, ElementName=CoverHost}"
                                    BorderBrush="{DynamicResource ImageStrokeBrush}" IsHitTestVisible="False" />
                            <Border x:Name="SelectionIndicator" Width="28" Height="3" CornerRadius="1.5"
                                    HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,-6"
                                    Background="{DynamicResource AccentBrush}" Visibility="Collapsed" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform />
                                </Border.RenderTransform>
                            </Border>
                            </Grid>
                            <TextBlock Text="{Binding DisplayName}"
                                       Style="{DynamicResource BaseTextBlockStyle}"
                                       TextAlignment="Center" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"
                                       Padding="2,5,2,5"
                                       Width="{Settings GridItemWidth}"
                                       Visibility="{Settings ShowNamesUnderCovers}" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding Tag, ElementName=CoverHost}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="PosterCover" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Visibility, ElementName=PosterCover}" Value="Visible">
                            <Setter Property="Visibility" Value="Hidden" TargetName="PART_ImageCover" />
                        </DataTrigger>
                        <DataTrigger Binding="{PluginSettings Plugin=Fluent11Helper, Path=PosterTiles, FallbackValue=False}" Value="True">
                            <Setter Property="Height" Value="{DynamicResource Fluent11PosterTileHeight}" TargetName="CoverHost" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="SelectionIndicator" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsInstalled}" Value="False">
                            <Setter Property="Content" Value="&#xF0AE;" TargetName="PART_ButtonPlay" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings ShowGridItemBackground}" Value="False">
                            <Setter Property="Background" Value="Transparent" TargetName="CoverPlaceholder" />
                        </DataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsInstalled}" Value="False" />
                                <Condition Binding="{Settings DarkenUninstalledGamesGrid}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" TargetName="BorderUninstalled" />
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding CoverImage}" Value="{x:Null}" />
                                <Condition Binding="{Settings ShowNameEmptyCover}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" TargetName="TextGameName"/>
                        </MultiDataTrigger>
                        <DataTrigger Value="Collapsed">
                            <DataTrigger.Binding>
                                <MultiBinding Converter="{pcon:MultiBooleanToVisibilityConverter}">
                                    <Binding Path="IsMouseOver" RelativeSource="{RelativeSource Self}" Converter="{StaticResource InvertedBoolenConverter}" />
                                    <Binding Path="ContextMenu.IsOpen" ElementName="PART_PanelHost" Converter="{StaticResource InvertedBoolenConverter}"
                                             FallbackValue="True" />
                                </MultiBinding>
                            </DataTrigger.Binding>
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="GameControls" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="GameControls" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetName="PART_ImageCover"
                                                         Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                         To="1.03" Duration="0:0:0.35">
                                            <DoubleAnimation.EasingFunction>
                                                <ExponentialEase EasingMode="EaseOut" Exponent="6" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="PART_ImageCover"
                                                         Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                         To="1.03" Duration="0:0:0.35">
                                            <DoubleAnimation.EasingFunction>
                                                <ExponentialEase EasingMode="EaseOut" Exponent="6" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="GameControls" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.12" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="GameControls" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.12" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="PART_ImageCover"
                                                         Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                         To="1" Duration="0:0:0.35">
                                            <DoubleAnimation.EasingFunction>
                                                <ExponentialEase EasingMode="EaseOut" Exponent="6" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="PART_ImageCover"
                                                         Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                         To="1" Duration="0:0:0.35">
                                            <DoubleAnimation.EasingFunction>
                                                <ExponentialEase EasingMode="EaseOut" Exponent="6" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True" />
                                <Condition Binding="{Binding Source={x:Static SystemParameters.ClientAreaAnimation}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="SelectionIndicator" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                         From="0" To="1" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="SelectionIndicator" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                         From="0" To="1" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.EnterActions>
                        </MultiDataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
