<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    mc:Ignorable="d">

    <Style x:Key="SidebarExtraButton" TargetType="{x:Type Button}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Margin" Value="4,2" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border Background="{TemplateBinding Background}" CornerRadius="{DynamicResource ControlCornerRadius}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Indicator" Visibility="Collapsed" Grid.ColumnSpan="2"
                                    Width="3" Height="16" CornerRadius="1.5"
                                    HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Background="{DynamicResource AccentBrush}" RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform />
                                </Border.RenderTransform>
                            </Border>
                            <ContentPresenter TextElement.FontFamily="{DynamicResource FluentIconFont}" TextElement.FontSize="{TemplateBinding FontSize}"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <TextBlock x:Name="Label" Grid.Column="1" Visibility="Collapsed"
                                       Text="{TemplateBinding Tag}" Margin="2,0,12,0" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       FontFamily="{DynamicResource FontFamily}" FontSize="{DynamicResource FontSize}"
                                       Foreground="{TemplateBinding Foreground}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=StackPanel}}" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="Label" />
                        </DataTrigger>
                        <Trigger Property="Selector.IsSelected" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="Indicator" />
                        </Trigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding (Selector.IsSelected), RelativeSource={RelativeSource Self}}" Value="True" />
                                <Condition Binding="{Binding Source={x:Static SystemParameters.ClientAreaAnimation}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Indicator" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                         From="0" To="1" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Indicator" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                         From="0" To="1" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.EnterActions>
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=StackPanel}}" Value="True" />
                                <Condition Binding="{Binding Source={x:Static SystemParameters.ClientAreaAnimation}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="Label" Storyboard.TargetProperty="Opacity"
                                                         From="0" To="1" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.EnterActions>
                        </MultiDataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource SubtleHoverBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource SubtleSelectedBrush}" />
            </Trigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=StackPanel}}" Value="True">
                <Setter Property="Width" Value="Auto" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SidebarAddonsButton" TargetType="{x:Type Button}" BasedOn="{StaticResource SidebarExtraButton}">
        <Style.Triggers>
            <DataTrigger Binding="{PluginSettings Plugin=Fluent11Helper, Path=ShowAddonsButton, FallbackValue=True}" Value="False">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SidebarFluent11Button" TargetType="{x:Type Button}" BasedOn="{StaticResource SidebarExtraButton}">
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <DataTrigger Binding="{PluginSettings Plugin=Fluent11Helper, Path=ShowFluent11Button, FallbackValue=False}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{PluginSettings Plugin=Fluent11Helper, Path=SettingsPageOpen, FallbackValue=False}" Value="True">
                <Setter Property="Selector.IsSelected" Value="True" />
                <Setter Property="Background" Value="{DynamicResource SubtleSelectedBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SidebarUpdateButton" TargetType="{x:Type Button}" BasedOn="{StaticResource SidebarExtraButton}">
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding UpdatesAvailable}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SidebarExpandToggle" TargetType="{x:Type ToggleButton}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Margin" Value="4,0" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border Background="{TemplateBinding Background}" CornerRadius="{DynamicResource ControlCornerRadius}">
                        <TextBlock x:Name="Glyph" Text="&#xE700;" FontFamily="{DynamicResource FluentIconFont}" FontSize="16"
                                   Foreground="{TemplateBinding Foreground}" RenderTransformOrigin="0.5,0.5"
                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.RenderTransform>
                                <ScaleTransform />
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </Border>
                    <ControlTemplate.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsPressed, RelativeSource={RelativeSource Self}}" Value="True" />
                                <Condition Binding="{Binding Source={x:Static SystemParameters.ClientAreaAnimation}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Glyph" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                         To="0.6" Duration="0:0:0.1" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.EnterActions>
                            <MultiDataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="Glyph" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                         To="1" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.ExitActions>
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsPressed, RelativeSource={RelativeSource Self}}" Value="True" />
                                <Condition Binding="{Binding Source={x:Static SystemParameters.ClientAreaAnimation}}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="RenderTransform" TargetName="Glyph">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.6" />
                                </Setter.Value>
                            </Setter>
                        </MultiDataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource SubtleHoverBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource SubtleSelectedBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type Sidebar}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Sidebar}">
                    <Border BorderThickness="0"
                            x:Name="BorderContentHolder" Margin="{TemplateBinding Padding}">
                        <DockPanel x:Name="DockContentHolder">
                            <StackPanel x:Name="FooterHost" DockPanel.Dock="Bottom" Orientation="Vertical" Margin="0,0,0,4"
                                        Tag="{Binding IsChecked, ElementName=ExpandToggle}">
                                <Button x:Name="ButtonUpdate" Command="{Binding OpenUpdatesCommand}"
                                        ToolTip="{DynamicResource LOCUpdateIsAvailableNotificationBody}" Tag="{DynamicResource LOCUpdaterWindowTitle}"
                                        Style="{DynamicResource SidebarUpdateButton}" Content="&#xE896;" />
                                <Border x:Name="PART_ElemMainMenu" Background="Transparent"
                                        Width="40" Height="36" Margin="4,2" HorizontalAlignment="Left"
                                        ToolTip="Menu"
                                        CornerRadius="{DynamicResource ControlCornerRadius}"
                                        WindowChrome.IsHitTestVisibleInChrome="True">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="&#xE712;" FontFamily="{DynamicResource FluentIconFont}" FontSize="16"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <TextBlock x:Name="MainMenuLabel" Grid.Column="1" Visibility="Collapsed"
                                                   Text="Menu" Margin="2,0,12,0"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                   FontFamily="{DynamicResource FontFamily}" FontSize="{DynamicResource FontSize}"
                                                   Foreground="{DynamicResource TextBrush}" />
                                    </Grid>
                                </Border>
                                <Button x:Name="ButtonFluent11" Command="{PluginSettings Plugin=Fluent11Helper, Path=OpenSettingsCommand}"
                                        ToolTip="Fluent 11" Tag="Fluent 11"
                                        Style="{DynamicResource SidebarFluent11Button}">
                                    <Viewbox Width="16" Height="16">
                                        <Canvas Width="20" Height="20">
                                            <Path Canvas.Left="-2.8" Canvas.Top="-2.45" Data="{DynamicResource Fluent11IconLines}"
                                                  StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                            <Path Canvas.Left="-2.8" Canvas.Top="-2.45" Data="{DynamicResource Fluent11IconSparkle}"
                                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                        </Canvas>
                                    </Viewbox>
                                </Button>
                                <Grid x:Name="AddonsHost" Visibility="{Binding Visibility, ElementName=ButtonAddons}">
                                    <Button x:Name="ButtonAddons" Command="{Binding OpenAddonsCommand}"
                                            ToolTip="{DynamicResource LOCMenuAddons}" Tag="Add-ons"
                                            Style="{DynamicResource SidebarAddonsButton}" Content="&#xE74C;" />
                                    <Border x:Name="AddonsBadge" IsHitTestVisible="False"
                                            Visibility="{DynamicResource Fluent11AddonUpdateBadgeVisibility}"
                                            MinWidth="16" Height="16" CornerRadius="8" Padding="4,0" Margin="25,5,0,0"
                                            HorizontalAlignment="Left" VerticalAlignment="Top"
                                            Background="{DynamicResource AccentBrush}">
                                        <TextBlock Text="{DynamicResource Fluent11AddonUpdateCount}" FontSize="10"
                                                   Foreground="{DynamicResource TextOnAccentBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </Grid>
                                <Button x:Name="ButtonSettings" Command="{Binding OpenSettingsCommand}"
                                        ToolTip="{DynamicResource LOCSettingsLabel}" Tag="{DynamicResource LOCSettingsLabel}"
                                        Style="{DynamicResource SidebarExtraButton}" Content="&#xE713;" FontSize="15" />
                            </StackPanel>

                            <Grid x:Name="ExpandToggleHost" DockPanel.Dock="Top" Height="50">
                                <ToggleButton x:Name="ExpandToggle" Style="{StaticResource SidebarExpandToggle}"
                                              IsChecked="{PluginSettings Plugin=Fluent11Helper, Path=SidebarExpanded, Mode=TwoWay, FallbackValue=True}" />
                            </Grid>

                            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden"
                                          DockPanel.Dock="Top" CanContentScroll="True"
                                          x:Name="ScrollSidebarItems">
                                <StackPanel x:Name="SidebarItemsHost" Orientation="Vertical"
                                            Tag="{Binding IsChecked, ElementName=ExpandToggle}">
                                    <StackPanel x:Name="PART_PanelSideBarItems" Orientation="Vertical"
                                                Tag="{Binding IsChecked, ElementName=ExpandToggle}" />
                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True" SourceName="PART_ElemMainMenu">
                            <Setter Property="Background" Value="{DynamicResource SubtleHoverBrush}" TargetName="PART_ElemMainMenu" />
                        </Trigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsChecked, ElementName=ExpandToggle}" Value="True" />
                                <Condition Binding="{Binding Source={x:Static SystemParameters.ClientAreaAnimation}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="MainMenuLabel" Storyboard.TargetProperty="Opacity"
                                                         From="0" To="1" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.EnterActions>
                        </MultiDataTrigger>
                        <DataTrigger Binding="{Binding ContextMenu.IsOpen, ElementName=PART_ElemMainMenu}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource SubtleHoverBrush}" TargetName="PART_ElemMainMenu" />
                        </DataTrigger>
                        <Trigger Property="IsChecked" Value="True" SourceName="ExpandToggle">
                            <Setter Property="ToolTipService.IsEnabled" Value="False" TargetName="ButtonUpdate" />
                            <Setter Property="ToolTipService.IsEnabled" Value="False" TargetName="PART_ElemMainMenu" />
                            <Setter Property="ToolTipService.IsEnabled" Value="False" TargetName="ButtonFluent11" />
                            <Setter Property="ToolTipService.IsEnabled" Value="False" TargetName="ButtonAddons" />
                            <Setter Property="ToolTipService.IsEnabled" Value="False" TargetName="ButtonSettings" />
                            <Setter Property="MinWidth" Value="190" TargetName="BorderContentHolder" />
                            <Setter Property="MaxWidth" Value="220" TargetName="BorderContentHolder" />
                            <Setter Property="Width" Value="Auto" TargetName="PART_ElemMainMenu" />
                            <Setter Property="HorizontalAlignment" Value="Stretch" TargetName="PART_ElemMainMenu" />
                            <Setter Property="Visibility" Value="Visible" TargetName="MainMenuLabel" />
                            <Setter Property="HorizontalAlignment" Value="Right" TargetName="AddonsBadge" />
                            <Setter Property="VerticalAlignment" Value="Center" TargetName="AddonsBadge" />
                            <Setter Property="Margin" Value="0,0,16,0" TargetName="AddonsBadge" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
