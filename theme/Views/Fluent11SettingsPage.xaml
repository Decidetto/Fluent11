<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent" TextElement.Foreground="{DynamicResource TextBrush}">
    <Grid.Resources>
        <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}" />
    </Grid.Resources>

    <Grid.RowDefinitions>
        <RowDefinition Height="48" />
        <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Text="Fluent 11" Margin="4,0,146,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
               FontSize="{DynamicResource FontSizeLarger}" FontWeight="SemiBold" />

    <DockPanel Grid.Row="1" Margin="24,12,0,0">
        <Border DockPanel.Dock="Top" HorizontalAlignment="Left" MaxWidth="1200" Margin="0,8,24,0" Padding="16,8" MinHeight="48"
                BorderThickness="1" CornerRadius="{DynamicResource ControlCornerRadius}"
                Background="{DynamicResource SurfaceCardBrush}" BorderBrush="{DynamicResource CardStrokeBrush}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding NeedsRestart}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="&#xE946;" FontFamily="{DynamicResource FluentIconFont}" FontSize="16"
                           Foreground="{DynamicResource AccentBrush}" Margin="0,0,12,0" VerticalAlignment="Center" />
                <Button DockPanel.Dock="Right" Content="Restart" Command="{Binding RestartCommand}" Margin="16,0,0,0"
                        VerticalAlignment="Center">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CanRestart}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <TextBlock Text="Some changes take effect after restarting Playnite." TextWrapping="Wrap" VerticalAlignment="Center" />
            </DockPanel>
        </Border>
        <Grid Style="{DynamicResource Fluent11PageEntrance}">
            <ContentControl x:Name="SettingsHost" Focusable="False" />
        </Grid>
    </DockPanel>
</Grid>
