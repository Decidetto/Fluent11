<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    mc:Ignorable="d">

    <Style TargetType="{x:Type GridViewGameOverview}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GridViewGameOverview}">
                    <Grid />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{PluginSettings Plugin=Fluent11Helper, Path=GridSidePanel, FallbackValue=False}" Value="True" />
                    <Condition Binding="{PluginSettings Plugin=Fluent11Helper, Path=GridOverlayActive, FallbackValue=False}" Value="False" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Template" Value="{DynamicResource Fluent11GameOverviewTemplate}" />
                <Setter Property="Margin" Value="1,0,0,0" />
                <Setter Property="Tag" Value="SidePanel" />
            </MultiDataTrigger>
            <DataTrigger Binding="{PluginSettings Plugin=Fluent11Helper, Path=GridOverlayActive, FallbackValue=False}" Value="True">
                <Setter Property="Template" Value="{DynamicResource Fluent11GameOverviewTemplate}" />
                <Setter Property="Margin" Value="9,6,9,13" />
                <Setter Property="Tag" Value="Overlay" />
            </DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{PluginSettings Plugin=Fluent11Helper, Path=GridOverlayActive, FallbackValue=False}" Value="True" />
                    <Condition Binding="{PluginSettings Plugin=Fluent11Helper, Path=GridOverlayFull, FallbackValue=False}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Margin" Value="1,1,0,0" />
                <Setter Property="Tag" Value="OverlayBack" />
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>