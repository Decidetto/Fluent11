<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Focusable="True" FocusVisualStyle="{x:Null}">
    <Grid.Resources>
        <Style x:Key="VideoButton" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource VideoBarTextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Back" Background="Transparent" CornerRadius="{DynamicResource ControlCornerRadius}">
                            <TextBlock Text="{TemplateBinding Content}" FontFamily="{DynamicResource FluentIconFont}" FontSize="16"
                                       Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource VideoButtonHoverBrush}" TargetName="Back" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{DynamicResource VideoButtonPressedBrush}" TargetName="Back" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ViewerButton" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Border x:Name="Back" Width="28" Height="28" Background="Transparent" CornerRadius="14" />
                            <TextBlock Text="{TemplateBinding Content}" FontFamily="{DynamicResource FluentIconFont}" FontSize="16"
                                       Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SubtleHoverBrush}" TargetName="Back" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SubtlePressedBrush}" TargetName="Back" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="VideoSlider" TargetType="Slider" BasedOn="{StaticResource {x:Type Slider}}">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource VideoTrackBrush}" />
        </Style>
        <Style x:Key="ViewerArrow" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Margin" Value="12,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border Background="{DynamicResource PopupBackgroundBrush}" Opacity="0.8"
                                    CornerRadius="20" />
                            <Border BorderBrush="{DynamicResource PopupBorderBrush}"
                                    BorderThickness="1" CornerRadius="20" />
                            <Border x:Name="Overlay" Background="Transparent" CornerRadius="20" />
                            <TextBlock x:Name="Glyph" Opacity="0.6" Text="{TemplateBinding Content}" FontFamily="{DynamicResource FluentIconFont}" FontSize="10"
                                       Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       RenderTransformOrigin="0.5,0.5">
                                <TextBlock.RenderTransform>
                                    <ScaleTransform />
                                </TextBlock.RenderTransform>
                            </TextBlock>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SubtleHoverBrush}" TargetName="Overlay" />
                                <Setter Property="Opacity" Value="1" TargetName="Glyph" />
                            </Trigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                    <Condition Binding="{Binding Source={x:Static SystemParameters.ClientAreaAnimation}}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <MultiDataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Glyph" Storyboard.TargetProperty="RenderTransform.ScaleX" To="1.15" Duration="0:0:0.1">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="Glyph" Storyboard.TargetProperty="RenderTransform.ScaleY" To="1.15" Duration="0:0:0.1">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </MultiDataTrigger.EnterActions>
                                <MultiDataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Glyph" Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="Glyph" Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </MultiDataTrigger.ExitActions>
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsPressed, RelativeSource={RelativeSource Self}}" Value="True" />
                                    <Condition Binding="{Binding Source={x:Static SystemParameters.ClientAreaAnimation}}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <MultiDataTrigger.EnterActions>
                                    <BeginStoryboard x:Name="ViewerPressDown">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Glyph" Storyboard.TargetProperty="RenderTransform.ScaleX" To="0.85" Duration="0:0:0.1">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="Glyph" Storyboard.TargetProperty="RenderTransform.ScaleY" To="0.85" Duration="0:0:0.1">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </MultiDataTrigger.EnterActions>
                                <MultiDataTrigger.ExitActions>
                                    <RemoveStoryboard BeginStoryboardName="ViewerPressDown" />
                                    <BeginStoryboard>
                                        <Storyboard FillBehavior="Stop">
                                            <DoubleAnimation Storyboard.TargetName="Glyph" Storyboard.TargetProperty="RenderTransform.ScaleX" From="0.85" To="1.15" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="Glyph" Storyboard.TargetProperty="RenderTransform.ScaleY" From="0.85" To="1.15" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </MultiDataTrigger.ExitActions>
                            </MultiDataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Grid.Resources>

    <Grid x:Name="Backdrop">
        <Image x:Name="BackdropImage" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality" />
        <Border x:Name="Dim" Background="{DynamicResource ViewerBackdropTintBrush}" />
    </Grid>

    <Grid x:Name="Frame" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource VideoBackgroundBrush}">
        <Image x:Name="Behind" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" Visibility="Collapsed" />
        <Image x:Name="Picture" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" Visibility="Collapsed" />
        <MediaElement x:Name="Video" LoadedBehavior="Manual" UnloadedBehavior="Manual" IsMuted="True"
                      Stretch="Uniform" ScrubbingEnabled="True" Visibility="Collapsed" />

        <StackPanel x:Name="Error" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="This video can't be played here." Foreground="{DynamicResource TextOnImageBrush}"
                       FontSize="{DynamicResource FontSizeLarge}" HorizontalAlignment="Center" />
            <Button x:Name="OpenExternal" Content="Open in default player" Margin="0,16,0,0" HorizontalAlignment="Center" />
        </StackPanel>

        <Button x:Name="Previous" Style="{StaticResource ViewerArrow}" Content="&#xEDD9;" HorizontalAlignment="Left" />
        <Button x:Name="Next" Style="{StaticResource ViewerArrow}" Content="&#xEDDA;" HorizontalAlignment="Right" />

        <Border x:Name="Bar" VerticalAlignment="Bottom" MaxWidth="640" Margin="12" Padding="4" Opacity="0"
                CornerRadius="{DynamicResource CardCornerRadius}" Background="{DynamicResource VideoBarBrush}"
                BorderBrush="{DynamicResource VideoBarStrokeBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="PlayPause" Style="{StaticResource VideoButton}" Content="&#xF5B0;" />
                <Slider x:Name="Seek" Grid.Column="1" Margin="12,0" Style="{StaticResource VideoSlider}" />
                <TextBlock x:Name="Time" Grid.Column="2" Margin="0,0,8,0" VerticalAlignment="Center"
                           FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource VideoBarTextBrush}" />
                <StackPanel x:Name="VolumePanel" Grid.Column="3" Orientation="Horizontal" Background="Transparent">
                    <Button x:Name="Mute" Style="{StaticResource VideoButton}" Content="&#xE74F;" />
                    <Slider x:Name="Volume" Width="88" Margin="4,0,8,0" Maximum="1">
                        <Slider.Style>
                            <Style TargetType="Slider" BasedOn="{StaticResource VideoSlider}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=StackPanel}}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Slider.Style>
                    </Slider>
                </StackPanel>
                <TextBlock x:Name="Counter" Grid.Column="4" Margin="8,0,8,0" VerticalAlignment="Center"
                           FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource VideoBarTextBrush}" />
                <Button x:Name="FullScreen" Grid.Column="5" Style="{StaticResource VideoButton}" Content="&#xE740;" />
            </Grid>
        </Border>

        <Grid x:Name="FullPill" Height="36" Margin="0,0,0,16" HorizontalAlignment="Center" VerticalAlignment="Bottom"
              Opacity="0" Visibility="Collapsed">
            <Border Background="{DynamicResource PopupBackgroundBrush}" Opacity="0.8" CornerRadius="18" />
            <Border BorderBrush="{DynamicResource PopupBorderBrush}" BorderThickness="1" CornerRadius="18" />
            <StackPanel Orientation="Horizontal" Margin="1">
                <StackPanel x:Name="FullCounter" Orientation="Horizontal" Margin="16,0" VerticalAlignment="Center">
                    <TextBlock x:Name="FullCounterCurrent" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                    <TextBlock x:Name="FullCounterTotal" Foreground="{DynamicResource TextBrushDarker}" />
                </StackPanel>
                <Border x:Name="FullDivider" Width="1" Margin="0,8" Background="{DynamicResource PopupBorderBrush}" />
                <Button x:Name="FullScreenExit" Style="{StaticResource ViewerButton}" Content="&#xE73F;" />
            </StackPanel>
        </Grid>
    </Grid>

    <Button x:Name="PreviousOutside" Style="{StaticResource ViewerArrow}" Content="&#xEDD9;" HorizontalAlignment="Center" />
    <Button x:Name="NextOutside" Style="{StaticResource ViewerArrow}" Content="&#xEDDA;" HorizontalAlignment="Center" />
    <StackPanel x:Name="Below" Height="68" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0">
        <TextBlock x:Name="Title" Height="24" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"
                   FontSize="{DynamicResource FontSizeLarge}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
        <Grid x:Name="Pill" Height="36" Margin="0,8,0,0" HorizontalAlignment="Center">
            <Border Background="{DynamicResource PopupBackgroundBrush}" Opacity="0.8" CornerRadius="18" />
            <Border BorderBrush="{DynamicResource PopupBorderBrush}" BorderThickness="1" CornerRadius="18" />
            <StackPanel Orientation="Horizontal" Margin="1">
                <StackPanel x:Name="CounterOutside" Orientation="Horizontal" Margin="16,0" VerticalAlignment="Center">
                    <TextBlock x:Name="CounterCurrent" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                    <TextBlock x:Name="CounterTotal" Foreground="{DynamicResource TextBrushDarker}" />
                </StackPanel>
                <Border x:Name="BelowDivider" Width="1" Margin="0,8" Background="{DynamicResource PopupBorderBrush}" />
                <Button x:Name="FullScreenOutside" Style="{StaticResource ViewerButton}" Content="&#xE740;" />
            </StackPanel>
        </Grid>
    </StackPanel>

    <StackPanel x:Name="Caption" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Collapsed">
        <Button x:Name="CaptionMinimize" Style="{DynamicResource WindowBarButton}" Content="&#xE921;" />
        <Button x:Name="CaptionMaximize" Style="{DynamicResource WindowBarButton}" Content="&#xE922;" />
        <Button x:Name="CaptionClose" Style="{DynamicResource WindowBarCloseButton}" Content="&#xE8BB;" />
    </StackPanel>
</Grid>
