<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:pbeh="clr-namespace:Playnite.Behaviors;assembly=Playnite"
                    xmlns:pcmd="clr-namespace:Playnite.Commands;assembly=Playnite"
                    mc:Ignorable="d">

    <Style x:Key="ChipListTwoRows" TargetType="ItemsControl">
        <Setter Property="MaxHeight" Value="62" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>

    <Style x:Key="ShowMoreLink" TargetType="Button" BasedOn="{StaticResource SimpleButton}">
        <Setter Property="Visibility" Value="Collapsed" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <TextBlock FontSize="{TemplateBinding FontSize}" Foreground="{TemplateBinding Foreground}"
                                   Text="{TemplateBinding Content}" VerticalAlignment="Center" />
                        <Grid Margin="6,1,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="Chevron" Text="&#xE70D;" FontFamily="{DynamicResource FluentIconFont}"
                                       FontSize="{DynamicResource FontSizeSmall}" Foreground="{TemplateBinding Foreground}" />
                        </Grid>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Content" Value="Show less">
                            <Setter Property="Text" Value="&#xE70E;" TargetName="Chevron" />
                        </Trigger>
                        <Trigger Property="Content" Value="View all">
                            <Setter Property="Text" Value="&#xE76C;" TargetName="Chevron" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="OverviewChip" TargetType="Button">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Margin" Value="0,0,6,6" />
        <Setter Property="Height" Value="25" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border Background="{DynamicResource ControlFillBrush}"
                                BorderBrush="{DynamicResource ControlStrokeBrush}" BorderThickness="1"
                                CornerRadius="{DynamicResource ControlCornerRadius}" />
                        <Border x:Name="Overlay" Background="Transparent"
                                CornerRadius="{DynamicResource ControlCornerRadius}" />
                        <TextBlock Margin="10,4,10,5" FontSize="{TemplateBinding FontSize}"
                                   FontFamily="{DynamicResource FontFamily}"
                                   Foreground="{TemplateBinding Foreground}"
                                   Text="{TemplateBinding Content, Converter={StaticResource ObjectToStringConverter}}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource SubtleHoverBrush}" TargetName="Overlay" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="{DynamicResource SubtlePressedBrush}" TargetName="Overlay" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <RectangleGeometry x:Key="AchievementIconClip" Rect="0,0,40,40" RadiusX="4" RadiusY="4" />

    <Style x:Key="OverviewCaption" TargetType="Label" BasedOn="{StaticResource {x:Type Label}}">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
    </Style>

    <ControlTemplate x:Key="Fluent11GameOverviewTemplate" TargetType="{x:Type GameOverview}">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto"
                                  Style="{DynamicResource DetailsScrollViewer}"
                                  d:DesignWidth="1280"
                                  d:DesignHeight="1280"
                                  d:DataContext="{x:Static DesignMainViewModel.DesignSelectedGameDetailsIntance}"
                                  x:Name="PART_ScrollViewHost">
                        <Grid x:Name="OverviewContent" Margin="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MaxWidth="1300" />
                            <ColumnDefinition Width="0" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Visibility="Collapsed" Text="{Binding Game.Id, NotifyOnTargetUpdated=True, Mode=OneWay}" />
                        <StackPanel Grid.Column="0">

                            <Grid Background="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid x:Name="DetailsCoverHost" Grid.Column="0" VerticalAlignment="Top">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Margin" Value="0,0,24,0" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Visibility, ElementName=PART_ImageCover}" Value="Collapsed">
                                                    <Setter Property="Margin" Value="0" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <Image Name="PART_ImageCover" Opacity="0"
                                           Height="{Settings GameDetailsCoverHeight}"
                                           StretchDirection="Both" Stretch="Uniform" />
                                    <Border CornerRadius="{DynamicResource CardCornerRadius}" Background="{DynamicResource LayerBrush}"
                                            Effect="{DynamicResource CoverShadowEffect}">
                                        <!-- Cache the blurred shadow so scrolling just moves it. -->
                                        <Border.CacheMode>
                                            <BitmapCache />
                                        </Border.CacheMode>
                                    </Border>
                                    <Border CornerRadius="{DynamicResource CardCornerRadius}">
                                        <Border.Background>
                                            <ImageBrush Stretch="UniformToFill" RenderOptions.BitmapScalingMode="Fant">
                                                <ImageBrush.ImageSource>
                                                    <PriorityBinding>
                                                        <Binding ElementName="DetailsCoverHost" Path="Tag.Image" />
                                                        <Binding ElementName="PART_ImageCover" Path="Source" />
                                                    </PriorityBinding>
                                                </ImageBrush.ImageSource>
                                            </ImageBrush>
                                        </Border.Background>
                                    </Border>
                                    <Border CornerRadius="{DynamicResource CardCornerRadius}" BorderThickness="1"
                                            BorderBrush="{DynamicResource ImageStrokeBrush}" IsHitTestVisible="False" />
                                </Grid>
                                <StackPanel Grid.Column="1" VerticalAlignment="Bottom">
                                    <DockPanel>
                                        <Image Name="PART_ImageIcon" MaxHeight="32" MaxWidth="32"
                                               DockPanel.Dock="Left" Margin="0,0,12,0"
                                               VerticalAlignment="Center"
                                               RenderOptions.BitmapScalingMode="Fant" />
                                        <TextBlock Name="PART_TextDisplayName" DockPanel.Dock="Left"
                                                   FontFamily="{DynamicResource FontFamilyDisplay}" FontWeight="SemiBold"
                                                   FontSize="{DynamicResource FontSizeLargest}" TextWrapping="Wrap"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextBrush}" />
                                    </DockPanel>
                                    <ItemsControl Name="PART_ItemsDevelopers" Margin="0,4,0,0" Focusable="False" AlternationCount="1000">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemContainerStyle>
                                            <Style TargetType="ContentPresenter">
                                                <Setter Property="Margin" Value="0,0,16,0" />
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <!-- Show up to four developers. -->
                                                    <Trigger Property="ItemsControl.AlternationIndex" Value="0">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </Trigger>
                                                    <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </Trigger>
                                                    <Trigger Property="ItemsControl.AlternationIndex" Value="2">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </Trigger>
                                                    <Trigger Property="ItemsControl.AlternationIndex" Value="3">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>
                                    </ItemsControl>
                                    <WrapPanel Orientation="Horizontal">
                                        <WrapPanel.Resources>
                                            <Style TargetType="StackPanel" x:Key="ScoreItem">
                                                <Setter Property="Orientation" Value="Horizontal" />
                                                <Setter Property="Margin" Value="0,4,0,0" />
                                            </Style>
                                            <Style TargetType="Border" x:Key="ScoreSeparator">
                                                <Setter Property="Width" Value="1" />
                                                <Setter Property="Height" Value="16" />
                                                <Setter Property="Margin" Value="12,0" />
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                                <Setter Property="Background" Value="{DynamicResource PanelSeparatorBrush}" />
                                            </Style>
                                            <Style TargetType="TextBlock" x:Key="ScoreValue" BasedOn="{StaticResource BaseTextBlockStyle}">
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                <Setter Property="Margin" Value="0,0,6,0" />
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                            </Style>
                                            <Style TargetType="Label" x:Key="ScoreLabel" BasedOn="{StaticResource {x:Type Label}}">
                                                <Setter Property="Padding" Value="0" />
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                                <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
                                            </Style>
                                        </WrapPanel.Resources>
                                        <StackPanel x:Name="CommunityItem">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel" BasedOn="{StaticResource ScoreItem}">
                                                    <Setter Property="Visibility" Value="{Binding Visibility, ElementName=PART_ElemCommunityScore}" />
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{PluginSettings Plugin=Fluent11Helper, Path=HasReviews, FallbackValue=False}" Value="True" />
                                                                <Condition Binding="{PluginSettings Plugin=Fluent11Helper, Path=SteamReviewsCard, FallbackValue=False}" Value="True" />
                                                                <Condition Binding="{Settings DetailsVisibility.CommunityScore}" Value="True" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <StackPanel x:Name="PlayniteCommunityScore" Orientation="Horizontal">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{PluginSettings Plugin=Fluent11Helper, Path=HasReviews, FallbackValue=False}" Value="True" />
                                                                    <Condition Binding="{PluginSettings Plugin=Fluent11Helper, Path=SteamReviewsCard, FallbackValue=False}" Value="True" />
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <TextBlock Name="PART_TextCommunityScore" Style="{StaticResource ScoreValue}" />
                                                <Label Name="PART_ElemCommunityScore" Content="{DynamicResource LOCCommunityScore}" Style="{StaticResource ScoreLabel}" />
                                            </StackPanel>
                                            <StackPanel x:Name="SteamRating" Orientation="Horizontal">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{PluginSettings Plugin=Fluent11Helper, Path=HasReviews, FallbackValue=False}" Value="True" />
                                                                    <Condition Binding="{PluginSettings Plugin=Fluent11Helper, Path=SteamReviewsCard, FallbackValue=False}" Value="True" />
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <TextBlock Text="{PluginSettings Plugin=Fluent11Helper, Path=Reviews.Percent, FallbackValue=''}" Style="{StaticResource ScoreValue}" />
                                                <TextBlock Text="{PluginSettings Plugin=Fluent11Helper, Path=Reviews.Rating, FallbackValue=''}" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextBrushDarker}" Style="{StaticResource BaseTextBlockStyle}" />
                                                <Border Style="{StaticResource ScoreSeparator}" />
                                                <TextBlock Text="{PluginSettings Plugin=Fluent11Helper, Path=Reviews.Count, FallbackValue=''}" VerticalAlignment="Center"
                                                           ToolTip="{PluginSettings Plugin=Fluent11Helper, Path=Reviews.ExactCount, FallbackValue=''}"
                                                           Foreground="{DynamicResource TextBrushDarker}" Style="{StaticResource BaseTextBlockStyle}" />
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Style="{StaticResource ScoreItem}" Visibility="{Binding Visibility, ElementName=PART_ElemCriticScore}">
                                            <Border Visibility="{Binding Visibility, ElementName=CommunityItem}">
                                                <Border.Style>
                                                    <Style TargetType="Border" BasedOn="{StaticResource ScoreSeparator}" />
                                                </Border.Style>
                                            </Border>
                                            <TextBlock Name="PART_TextCriticScore" Style="{StaticResource ScoreValue}" />
                                            <Label Name="PART_ElemCriticScore" Content="{DynamicResource LOCCriticScore}" Style="{StaticResource ScoreLabel}" />
                                        </StackPanel>
                                        <StackPanel Style="{StaticResource ScoreItem}" Visibility="{Binding Visibility, ElementName=PART_ElemUserScore}">
                                            <Border>
                                                <Border.Style>
                                                    <Style TargetType="Border" BasedOn="{StaticResource ScoreSeparator}">
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding Visibility, ElementName=CommunityItem}" Value="Collapsed" />
                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemCriticScore}" Value="Collapsed" />
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                            <TextBlock Name="PART_TextUserScore" Style="{StaticResource ScoreValue}" />
                                            <Label Name="PART_ElemUserScore" Content="{DynamicResource LOCUserScore}" Style="{StaticResource ScoreLabel}" />
                                        </StackPanel>
                                        <StackPanel Style="{StaticResource ScoreItem}" Visibility="{Binding Visibility, ElementName=PART_ElemGenres}">
                                            <Border>
                                                <Border.Style>
                                                    <Style TargetType="Border" BasedOn="{StaticResource ScoreSeparator}">
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding Visibility, ElementName=CommunityItem}" Value="Collapsed" />
                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemCriticScore}" Value="Collapsed" />
                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemUserScore}" Value="Collapsed" />
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                            <ItemsControl ItemsSource="{Binding Game.Genres}" Focusable="False" AlternationCount="1000" VerticalAlignment="Center">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemContainerStyle>
                                                    <Style TargetType="ContentPresenter">
                                                        <Setter Property="Margin" Value="16,0,0,0" />
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <!-- Show up to four genres, spaced like the developers. -->
                                                            <Trigger Property="ItemsControl.AlternationIndex" Value="0">
                                                                <Setter Property="Margin" Value="0" />
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </Trigger>
                                                            <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </Trigger>
                                                            <Trigger Property="ItemsControl.AlternationIndex" Value="2">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </Trigger>
                                                            <Trigger Property="ItemsControl.AlternationIndex" Value="3">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ItemsControl.ItemContainerStyle>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Content="{Binding Name}" Margin="0" Style="{DynamicResource PropertyItemButton}"
                                                                Command="{Binding DataContext.SetGenreFilterCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </WrapPanel>
                                    <Border Name="PART_ElemNotes" />
                                    <Grid Margin="0,8,0,0" Visibility="{Binding Visibility, ElementName=PART_ElemNotes}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3*" MinWidth="320" />
                                            <ColumnDefinition Width="2*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Game.Notes}"
                                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                                   LineStackingStrategy="BlockLineHeight" LineHeight="20" MaxHeight="40"
                                                   FontSize="{DynamicResource FontSize}" Foreground="{DynamicResource TextBrushDarker}" />
                                    </Grid>
                                    <StackPanel HorizontalAlignment="Left" Orientation="Horizontal" Margin="0,16,0,0">
                                        <Button Name="PART_ButtonPlayAction"
                                                MinWidth="120" Height="36" Style="{DynamicResource PlayButton}" />
                                        <Button Name="PART_ButtonContextAction"
                                                MinWidth="120" Height="36" />
                                        <Menu x:Name="PART_ElemLinks" Margin="8,0,0,0" Background="Transparent" VerticalAlignment="Center">
                                            <MenuItem ItemsSource="{Binding Game.Links}" ToolTip="{DynamicResource LOCLinksLabel}"
                                                      Width="36" Height="36" Focusable="False">
                                                <MenuItem.ItemContainerStyle>
                                                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                                        <Setter Property="Header" Value="{Binding Name}" />
                                                        <Setter Property="ToolTip" Value="{Binding Url}" />
                                                        <Setter Property="Command" Value="{Binding DataContext.OpenLinkCommand, RelativeSource={RelativeSource AncestorType=Menu}}" />
                                                        <Setter Property="CommandParameter" Value="{Binding}" />
                                                    </Style>
                                                </MenuItem.ItemContainerStyle>
                                                <MenuItem.Template>
                                                    <ControlTemplate TargetType="MenuItem">
                                                        <Grid>
                                                            <Border Background="{DynamicResource ButtonBackgroundBrush}"
                                                                    BorderBrush="{DynamicResource ControlStrokeBrush}"
                                                                    BorderThickness="{DynamicResource ControlBorderThickness}"
                                                                    CornerRadius="{DynamicResource ControlCornerRadius}" />
                                                            <Border BorderBrush="{DynamicResource ControlStrokeBottomBrush}" BorderThickness="0,0,0,1"
                                                                    CornerRadius="{DynamicResource ControlCornerRadius}" />
                                                            <Border x:Name="Overlay" Background="Transparent" CornerRadius="{DynamicResource ControlCornerRadius}" />
                                                            <TextBlock Text="&#xE71B;" FontFamily="{DynamicResource FluentIconFont}" FontSize="{DynamicResource FontSize}"
                                                                       Foreground="{DynamicResource TextBrush}"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            <Popup x:Name="Fluent11SubmenuPopup" IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                                                   Placement="Bottom" HorizontalOffset="-8" VerticalOffset="0"
                                                                   Focusable="False" AllowsTransparency="{DynamicResource Fluent11PopupTransparent}">
                                                                <Grid Style="{DynamicResource PopupRoot}">
                                                                    <Border x:Name="SubShadow" Style="{DynamicResource PopupShadow}" />
                                                                    <Border x:Name="SubCard" Style="{DynamicResource PopupBorder}">
                                                                        <ScrollViewer Style="{DynamicResource MenuScrollViewer}"
                                                                                      MaxHeight="{DynamicResource MenuMaxHeight}">
                                                                            <StackPanel Grid.IsSharedSizeScope="True" IsItemsHost="True"
                                                                                        KeyboardNavigation.DirectionalNavigation="Cycle" />
                                                                        </ScrollViewer>
                                                                    </Border>
                                                                </Grid>
                                                            </Popup>
                                                        </Grid>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource SubtleHoverBrush}" TargetName="Overlay" />
                                                            </Trigger>
                                                            <Trigger Property="IsSubmenuOpen" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource SubtlePressedBrush}" TargetName="Overlay" />
                                                            </Trigger>
                                                            <Trigger SourceName="Fluent11SubmenuPopup" Property="AllowsTransparency" Value="False">
                                                                <Setter TargetName="SubShadow" Property="Visibility" Value="Collapsed" />
                                                                <Setter TargetName="SubCard" Property="Margin" Value="0" />
                                                                <Setter TargetName="SubCard" Property="BorderBrush" Value="{DynamicResource PopupAcrylicBorderBrush}" />
                                                                <Setter TargetName="SubCard" Property="Background" Value="{DynamicResource PopupAcrylicBrush}" />
                                                                <Setter TargetName="Fluent11SubmenuPopup" Property="HorizontalOffset" Value="0" />
                                                                <Setter TargetName="Fluent11SubmenuPopup" Property="VerticalOffset" Value="4" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </MenuItem.Template>
                                            </MenuItem>
                                        </Menu>
                                        <Button x:Name="PART_ButtonEditGame"
                                                Margin="8,0,0,0" Height="36" Width="36" Padding="0" Focusable="False"
                                                Content="&#xE932;" FontFamily="{DynamicResource FluentIconFont}" />
                                        <Button Name="PART_ButtonMoreActions" ToolTip="{DynamicResource LOCMoreAction}"
                                                Margin="8,0,0,0" Height="36" Width="36" Padding="0" Focusable="False"
                                                Content="&#xE712;" FontFamily="{DynamicResource FluentIconFont}" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>

                            <WrapPanel Margin="0,24,0,0" Orientation="Horizontal">
                                <WrapPanel.Resources>
                                    <Style TargetType="Border" x:Key="StatTile" BasedOn="{StaticResource SurfaceCard}">
                                        <Setter Property="MinWidth" Value="160" />
                                        <Setter Property="Margin" Value="0,0,8,8" />
                                        <Setter Property="Padding" Value="16,12" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="SidePanel">
                                                <Setter Property="MinWidth" Value="112" />
                                                <Setter Property="Padding" Value="10,6" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                    <Style TargetType="TextBlock" x:Key="StatValue" BasedOn="{StaticResource BaseTextBlockStyle}">
                                        <Setter Property="FontSize" Value="{DynamicResource FontSizeLarger}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="SidePanel">
                                                <Setter Property="FontSize" Value="{DynamicResource FontSizeLarge}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </WrapPanel.Resources>
                                <Border>
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource StatTile}">
                                            <Setter Property="Visibility" Value="{Binding Visibility, ElementName=PART_ElemPlayTime}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Game.Playtime}" Value="0">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <Label Name="PART_ElemPlayTime" Content="{DynamicResource LOCTimePlayed}" Style="{StaticResource OverviewCaption}" />
                                        <TextBlock Name="PART_TextPlayTime" Style="{StaticResource StatValue}" />
                                    </StackPanel>
                                </Border>
                                <Border>
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource StatTile}">
                                            <Setter Property="Visibility" Value="{Binding Visibility, ElementName=PART_ElemLastPlayed}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Game.LastActivity}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <Label Name="PART_ElemLastPlayed" Content="{DynamicResource LOCLastPlayed}" Style="{StaticResource OverviewCaption}" />
                                        <TextBlock Name="PART_TextLastActivity" Style="{StaticResource StatValue}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource StatTile}" Visibility="{Binding Visibility, ElementName=PART_ElemCompletionStatus}">
                                    <StackPanel>
                                        <Label Name="PART_ElemCompletionStatus" Content="{DynamicResource LOCCompletionStatus}" Style="{StaticResource OverviewCaption}" />
                                        <Button Name="PART_ButtonCompletionStatus" Style="{DynamicResource PropertyItemButton}"
                                                FontSize="{DynamicResource FontSizeLarger}" FontWeight="SemiBold" Margin="0" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource StatTile}" Visibility="{Binding Visibility, ElementName=PART_ElemInstallSize}">
                                    <StackPanel>
                                        <Label Name="PART_ElemInstallSize" Content="{DynamicResource LOCInstallSizeLabel}" Style="{StaticResource OverviewCaption}" />
                                        <TextBlock>
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource StatValue}">
                                                    <Setter Property="Text" Value="{Binding Game.InstallSize, Converter={StaticResource MathConverter}, ConverterParameter='Round(x/1073741824)', StringFormat='{}{0} GB'}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Game.InstallSize, Converter={StaticResource MathConverter}, ConverterParameter='Round(x/1073741824-0.5)'}" Value="0">
                                                            <Setter Property="Text" Value="{Binding Game.InstallSize, Converter={StaticResource MathConverter}, ConverterParameter='Round(x/1048576)', StringFormat='{}{0} MB'}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                                <Border>
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource StatTile}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
