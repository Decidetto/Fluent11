<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    mc:Ignorable="d">



    <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource GlyphColor}" />
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="{DynamicResource TextOnAccentColor}" />
    <SolidColorBrush x:Key="LayerBrush" Color="{DynamicResource LayerColor}" />
    <SolidColorBrush x:Key="ContentLayerBrush" Color="{DynamicResource LayerColor}" />
    <SolidColorBrush x:Key="SurfaceCardBrush" Color="{DynamicResource SurfaceCardColor}" />
    <SolidColorBrush x:Key="CardStrokeBrush" Color="{DynamicResource CardStrokeColor}" />
    <SolidColorBrush x:Key="ImageStrokeBrush" Color="{DynamicResource ImageStrokeColor}" />
    <SolidColorBrush x:Key="ControlFillBrush" Color="{DynamicResource ControlFillColor}" />
    <SolidColorBrush x:Key="ControlAltFillBrush" Color="{DynamicResource ControlAltFillColor}" />
    <SolidColorBrush x:Key="ControlFillFocusedBrush" Color="{DynamicResource ControlFillFocusedColor}" />
    <SolidColorBrush x:Key="ControlSolidFillBrush" Color="{DynamicResource ControlSolidFillColor}" />
    <SolidColorBrush x:Key="SubtleHoverBrush" Color="{DynamicResource SubtleHoverColor}" />
    <SolidColorBrush x:Key="SubtlePressedBrush" Color="{DynamicResource SubtlePressedColor}" />
    <SolidColorBrush x:Key="SubtleSelectedBrush" Color="{DynamicResource SubtleSelectedColor}" />
    <SolidColorBrush x:Key="CoverHoverOverlayBrush" Color="{DynamicResource CoverHoverOverlayColor}" />
    <SolidColorBrush x:Key="CoverNameOverlayBrush" Color="{DynamicResource CoverNameOverlayColor}" />
    <SolidColorBrush x:Key="ShotHoverBrush" Color="{DynamicResource ShotHoverColor}" />
    <SolidColorBrush x:Key="CoverPlayBackplateBrush" Color="{DynamicResource CoverPlayBackplateColor}" />
    <SolidColorBrush x:Key="TextOnImageBrush" Color="{DynamicResource TextOnImageColor}" />
    <SolidColorBrush x:Key="TextOnLightBrush" Color="{DynamicResource TextOnLightColor}" />
    <SolidColorBrush x:Key="ControlStrokeBrush" Color="{DynamicResource ControlStrokeColor}" />
    <SolidColorBrush x:Key="ControlStrokeHoverBrush" Color="{DynamicResource ControlStrokeHoverColor}" />
    <SolidColorBrush x:Key="ControlStrokeBottomBrush" Color="{DynamicResource ControlStrokeBottomColor}" />
    <SolidColorBrush x:Key="ControlStrongStrokeBrush" Color="{DynamicResource ControlStrongStrokeColor}" />
    <SolidColorBrush x:Key="ProgressTrackBrush" Color="{DynamicResource ProgressTrackColor}" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="{DynamicResource ScrollThumbColor}" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="{DynamicResource TextDisabledColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{DynamicResource SuccessColor}" />
    <SolidColorBrush x:Key="CautionBrush" Color="{DynamicResource CautionColor}" />
    <SolidColorBrush x:Key="CautionBackgroundBrush" Color="{DynamicResource CautionBackgroundColor}" />
    <SolidColorBrush x:Key="CriticalBrush" Color="{DynamicResource CriticalColor}" />
    <SolidColorBrush x:Key="WindowCloseHoverBrush" Color="{DynamicResource WindowCloseHoverColor}" />
    <SolidColorBrush x:Key="WindowCloseHoverTextBrush" Color="{DynamicResource WindowCloseHoverTextColor}" />
    <SolidColorBrush x:Key="DialogFooterBrush" Color="{DynamicResource DialogFooterColor}" />
    <SolidColorBrush x:Key="OverlayDimBrush" Color="{DynamicResource OverlayDimColor}" />
    <SolidColorBrush x:Key="ViewerBackdropTintBrush" Color="{DynamicResource ViewerBackdropTintColor}" />
    <SolidColorBrush x:Key="VideoBackgroundBrush" Color="{DynamicResource VideoBackgroundColor}" />
    <SolidColorBrush x:Key="VideoBarBrush" Color="{DynamicResource VideoBarColor}" />
    <SolidColorBrush x:Key="VideoBarStrokeBrush" Color="{DynamicResource VideoBarStrokeColor}" />
    <SolidColorBrush x:Key="VideoBarTextBrush" Color="{DynamicResource VideoBarTextColor}" />
    <SolidColorBrush x:Key="VideoTrackBrush" Color="{DynamicResource VideoTrackColor}" />
    <SolidColorBrush x:Key="VideoButtonHoverBrush" Color="{DynamicResource VideoButtonHoverColor}" />
    <SolidColorBrush x:Key="VideoButtonPressedBrush" Color="{DynamicResource VideoButtonPressedColor}" />
    <SolidColorBrush x:Key="TimeMainBrush" Color="{DynamicResource TimeMainColor}" />
    <SolidColorBrush x:Key="TimeExtraBrush" Color="{DynamicResource TimeExtraColor}" />
    <SolidColorBrush x:Key="ReviewPositiveBrush" Color="{DynamicResource TimeMainColor}" />
    <SolidColorBrush x:Key="ReviewNegativeBrush" Color="{DynamicResource TimeExtraColor}" />
    <SolidColorBrush x:Key="TimeCompletionistBrush" Color="{DynamicResource TimeCompletionistColor}" />

    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}" />
    <SolidColorBrush x:Key="TextBrushDarker" Color="{DynamicResource TextColorDarker}" />
    <SolidColorBrush x:Key="TextBrushDark" Color="{DynamicResource TextColorDark}" />
    <SolidColorBrush x:Key="NormalBrush" Color="{DynamicResource MainColor}" />
    <SolidColorBrush x:Key="NormalBrushDark" Color="{DynamicResource MainColorDark}" />
    <SolidColorBrush x:Key="NormalBorderBrush" Color="{DynamicResource ControlStrokeColor}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{DynamicResource SubtleSelectedColor}" />
    <SolidColorBrush x:Key="GlyphBrush" Color="{DynamicResource TextColor}" />
    <SolidColorBrush x:Key="HighlightGlyphBrush" Color="{DynamicResource GlyphColor}" />
    <SolidColorBrush x:Key="PopupBorderBrush" Color="{DynamicResource PopupBorderColor}" />
    <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="{DynamicResource BackgroundToneColor}" />
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="{DynamicResource ControlFillColor}" />
    <SolidColorBrush x:Key="GridItemBackgroundBrush" Color="{DynamicResource GridItemBackgroundColor}" />
    <SolidColorBrush x:Key="PanelSeparatorBrush" Color="{DynamicResource PanelSeparatorColor}" />
    <SolidColorBrush x:Key="WindowPanelSeparatorBrush" Color="{DynamicResource WindowPanelSeparatorColor}" />
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="{DynamicResource PopupBackgroundColor}" />
    <SolidColorBrush x:Key="PopupAcrylicBrush" Color="{DynamicResource PopupAcrylicColor}" />
    <SolidColorBrush x:Key="PopupAcrylicBorderBrush" Color="{DynamicResource PopupAcrylicBorderColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckMarkBkBrush" Color="{DynamicResource ControlAltFillColor}" />
    <SolidColorBrush x:Key="DataChangeNotifBrush" Color="{DynamicResource DataChangeNotifColor}" />

    <SolidColorBrush x:Key="PositiveRatingBrush" Color="{DynamicResource SuccessColor}" />
    <SolidColorBrush x:Key="NegativeRatingBrush" Color="{DynamicResource CriticalColor}" />
    <SolidColorBrush x:Key="MixedRatingBrush" Color="{DynamicResource CautionColor}" />

    <SolidColorBrush x:Key="WarningBrush" Color="{DynamicResource CriticalColor}" />

    <SolidColorBrush x:Key="ExpanderBackgroundBrush" Color="{DynamicResource SurfaceCardColor}" />
    <SolidColorBrush x:Key="WindowBackgourndBrush" Color="{DynamicResource WindowBackgroundColor}" />

    <Style x:Key="BaseStyle" TargetType="Control">
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily}" />
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="BaseTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Fluent11OverlayDim" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource OverlayDimBrush}" />
        <Setter Property="Tag" Value="Fluent11OverlayDim" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <DataTrigger Binding="{PluginSettings Plugin=Fluent11Helper, Path=GridOverlayOpen, FallbackValue=False}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{PluginSettings Plugin=Fluent11Helper, Path=GridOverlayFull, FallbackValue=False}" Value="True">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsVisible, RelativeSource={RelativeSource Self}}" Value="True" />
                    <Condition Binding="{Binding Source={x:Static SystemParameters.ClientAreaAnimation}}" Value="True" />
                </MultiDataTrigger.Conditions>
                <MultiDataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.15" />
                        </Storyboard>
                    </BeginStoryboard>
                </MultiDataTrigger.EnterActions>
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="PanelCloseButton" TargetType="Button">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="{DynamicResource ControlCornerRadius}">
                        <TextBlock Text="&#xE8BB;" FontFamily="{DynamicResource FluentIconFont}" FontSize="12"
                                   Foreground="{TemplateBinding Foreground}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource SubtleHoverBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource SubtlePressedBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <sys:String x:Key="Fluent11AddonUpdateCount"></sys:String>
    <Visibility x:Key="Fluent11AddonUpdateBadgeVisibility">Collapsed</Visibility>

    <Style x:Key="ImageStrokeOverlay" TargetType="Border">
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource ImageStrokeBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Background.ImageSource, RelativeSource={RelativeSource AncestorType=Border}}" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="ImageStrokeOverlayOnImage" TargetType="Border">
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource ImageStrokeBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Children[0].Source, RelativeSource={RelativeSource AncestorType=Grid}}" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
