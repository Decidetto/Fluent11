<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:Double x:Key="FontSizeSmall">12</sys:Double>
    <sys:Double x:Key="FontSize">14</sys:Double>
    <sys:Double x:Key="FontSizeLarge">16</sys:Double>
    <sys:Double x:Key="FontSizeLarger">20</sys:Double>
    <sys:Double x:Key="FontSizeLargest">28</sys:Double>
    <FontFamily x:Key="FontFamily">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="FontFamilyDisplay">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="FluentIconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="MonospaceFontFamily">Cascadia Mono, Consolas</FontFamily>

    <Thickness x:Key="PopupBorderThickness">1</Thickness>
    <Thickness x:Key="ControlBorderThickness">1</Thickness>
    <sys:Double x:Key="EllipseBorderThickness">1</sys:Double>
    <CornerRadius x:Key="ControlCornerRadius">4</CornerRadius>
    <sys:Double x:Key="MenuMaxHeight">480</sys:Double>
    <sys:Double x:Key="MenuIconSize">16</sys:Double>
    <CornerRadius x:Key="CardCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">8</CornerRadius>
    <Thickness x:Key="SidebarItemPadding">8</Thickness>

    <sys:Boolean x:Key="Fluent11ThemeMarker">True</sys:Boolean>


    <Color x:Key="GlyphColor">#005FB8</Color>
    <Color x:Key="TextOnAccentColor">#FFFFFF</Color>

    <Color x:Key="WindowBackgroundColor">#F3F3F3</Color>
    <Color x:Key="LayerColor">#F9F9F9</Color>
    <Color x:Key="LayerOnMicaColor">#80FFFFFF</Color>
    <sys:Double x:Key="OverlayDetailsLayerOpacity">0.4</sys:Double>
    <Color x:Key="LayerFadeColor">#00F9F9F9</Color>
    <Color x:Key="LayerFadeEndColor">#80F9F9F9</Color>
    <Color x:Key="MaskOpaqueColor">#FF000000</Color>
    <Color x:Key="MaskClearColor">#00000000</Color>
    <Color x:Key="OverlayDimColor">#4D000000</Color>
    <Color x:Key="ViewerBackdropTintColor">#4DF3F3F3</Color>
    <Color x:Key="TimeMainColor">#005FB8</Color>
    <Color x:Key="TimeExtraColor">#4F9BDB</Color>
    <Color x:Key="TimeCompletionistColor">#A7CBEC</Color>
    <Color x:Key="SurfaceCardColor">#B3FFFFFF</Color>
    <Color x:Key="CardStrokeColor">#0F000000</Color>
    <Color x:Key="ImageStrokeColor">#14000000</Color>
    <Color x:Key="PopupBackgroundColor">#F9F9F9</Color>
    <Color x:Key="PopupAcrylicColor">#B3FFFFFF</Color>
    <sys:Boolean x:Key="Fluent11PopupTransparent">True</sys:Boolean>
    <Color x:Key="ControlFillColor">#B3FFFFFF</Color>
    <Color x:Key="ControlAltFillColor">#06000000</Color>
    <Color x:Key="ControlFillFocusedColor">#FFFFFF</Color>
    <Color x:Key="ControlSolidFillColor">#FFFFFF</Color>
    <Color x:Key="GridItemBackgroundColor">#E8E8E8</Color>

    <Color x:Key="SubtleHoverColor">#0A000000</Color>
    <Color x:Key="SubtlePressedColor">#06000000</Color>
    <Color x:Key="SubtleSelectedColor">#0F000000</Color>
    <Color x:Key="CoverHoverOverlayColor">#40000000</Color>
    <Color x:Key="CoverNameOverlayColor">#99000000</Color>
    <Color x:Key="ShotHoverColor">#26FFFFFF</Color>
    <Color x:Key="CoverPlayBackplateColor">#66000000</Color>
    <Color x:Key="HoverColor">#EDEDED</Color>

    <Color x:Key="ControlStrokeColor">#0F000000</Color>
    <Color x:Key="ControlStrokeHoverColor">#CCCCCC</Color>
    <Color x:Key="ControlStrokeBottomColor">#29000000</Color>
    <Color x:Key="ControlStrongStrokeColor">#8A8A8A</Color>
    <Color x:Key="ProgressTrackColor">#17000000</Color>
    <Color x:Key="PopupBorderColor">#E0E0E0</Color>
    <Color x:Key="PopupAcrylicBorderColor">#B8EAEAEA</Color>
    <Color x:Key="PanelSeparatorColor">#E5E5E5</Color>
    <Color x:Key="WindowPanelSeparatorColor">#E5E5E5</Color>
    <Color x:Key="ScrollThumbColor">#8A8A8A</Color>

    <Color x:Key="TextColor">#1B1B1B</Color>
    <Color x:Key="TextColorDarker">#5F5F5F</Color>
    <Color x:Key="TextColorDark">#1B1B1B</Color>
    <Color x:Key="TextDisabledColor">#A0A0A0</Color>
    <Color x:Key="TextOnImageColor">#FFFFFF</Color>
    <Color x:Key="TextOnLightColor">#1B1B1B</Color>
    <Color x:Key="VideoBackgroundColor">#000000</Color>
    <Color x:Key="VideoBarColor">#D9F3F3F3</Color>
    <Color x:Key="VideoBarStrokeColor">#0F000000</Color>
    <Color x:Key="VideoBarTextColor">#1B1B1B</Color>
    <Color x:Key="VideoTrackColor">#72000000</Color>
    <Color x:Key="VideoButtonHoverColor">#0A000000</Color>
    <Color x:Key="VideoButtonPressedColor">#06000000</Color>

    <Color x:Key="SuccessColor">#0F7B0F</Color>
    <Color x:Key="CautionColor">#9D5D00</Color>
    <Color x:Key="CautionBackgroundColor">#FFF4CE</Color>
    <Color x:Key="CriticalColor">#C42B1C</Color>
    <Color x:Key="DataChangeNotifColor">#9D5D00</Color>
    <Color x:Key="WindowCloseHoverColor">#C42B1C</Color>
    <Color x:Key="WindowCloseHoverTextColor">#FFFFFF</Color>
    <Color x:Key="DialogFooterColor">#F3F3F3</Color>
    <Color x:Key="ShadowColor">#000000</Color>

    <sys:String x:Key="HtmlPanelStylesheet">ul, li { color: #1B1B1B; }</sys:String>

    <Color x:Key="BlackColor">#FF000000</Color>
    <Color x:Key="WhiteColor">#FFFFFFFF</Color>
    <Color x:Key="MainColor">#C8C8C8</Color>
    <Color x:Key="MainColorDark">#FDFDFD</Color>
    <Color x:Key="HighlightGlyphColor">#0F000000</Color>
    <Color x:Key="BackgroundToneColor">#F9F9F9</Color>



    <DropShadowEffect x:Key="PopupShadowEffect" BlurRadius="16" ShadowDepth="4" Direction="270"
                      Opacity="0.14" Color="{StaticResource ShadowColor}" />

    <DropShadowEffect x:Key="CoverShadowEffect" BlurRadius="14" ShadowDepth="3" Direction="270"
                      Opacity="0.18" Color="{StaticResource ShadowColor}" />

    <DropShadowEffect x:Key="TileShadowEffect" BlurRadius="10" ShadowDepth="2" Direction="270"
                      Opacity="0.22" Color="{StaticResource ShadowColor}" />

</ResourceDictionary>
